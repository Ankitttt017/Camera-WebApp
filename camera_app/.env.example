# Copy to camera_app/.env and fill in the values marked <...>.
# Camera and PLC for event recording are set in the app (Settings / Plants & Cameras) and saved
# to helper_settings.json; they are not read from this file.

# ---- Database (SQL Server) ----
# development = local work, uses dev_ tables; production = live server tables
ENVIRONMENT=development
DB_SERVER=192.168.100.46
DB_PORT=1433
DB_NAME_DEV=RICO_IOT
DB_NAME_PROD=RICO_IOT
DB_USER=<db user>
DB_PASSWORD=<db password>
DB_ENCRYPT=no
DB_TABLE_PREFIX_DEV=dev_

# ---- Recording ----
RECORDING_MAX_WIDTH=1280
RECORDING_TARGET_FPS=20
RECORDING_FPS=20
RECORDING_CRF=24
# Gentle clean-up only: the recording is the evidence and Whisper's input
RECORDING_AUDIO_FILTER=highpass=f=100:poles=2,lowpass=f=3800:poles=2,afftdn=nr=12:nf=-40:tn=1,alimiter=limit=0.95
# Seconds FFmpeg gets to finish the file when a recording stops
RECORDING_FINALIZE_SECONDS=30

# ---- Live view ----
LIVE_PREVIEW_MAX_WIDTH=960
LIVE_PREVIEW_TARGET_FPS=12
LIVE_PREVIEW_JPEG_QUALITY=62
LIVE_PREVIEW_STALE_SECONDS=3
LIVE_PREVIEW_RTSP_PATH=/video/live?channel=1&subtype=1
LIVE_VIDEO_MAX_WIDTH=960
LIVE_VIDEO_TARGET_FPS=12
LIVE_VIDEO_BITRATE=1200k
LIVE_VIDEO_MAXRATE=1500k
LIVE_VIDEO_BUFSIZE=600k
LIVE_RTSP_TRANSPORT=tcp
# Restart a camera's live worker when it has produced no frame for this long
LIVE_STREAM_STALL_SECONDS=10

# ---- Live audio: operator voice only ----
LIVE_AUDIO_SPEECH_GATE=1
LIVE_AUDIO_PREFILTER=highpass=f=250:poles=2,lowpass=f=3600:poles=2,afftdn=nr=40:nf=-20:tn=1
LIVE_AUDIO_GATE_FLOOR_DB=-40
LIVE_AUDIO_OUTPUT_FILTER=volume=2.0,alimiter=limit=0.95

# ---- Voice to text (faster-whisper, runs locally, no cloud) ----
TRANSCRIPTION_ENABLED=1
TRANSCRIPTION_USE_FASTER_WHISPER=1
TRANSCRIPTION_MODEL=large-v3-turbo
TRANSCRIPTION_MODEL_CACHE=model_cache
TRANSCRIPTION_DEVICE=cpu
TRANSCRIPTION_COMPUTE_TYPE=int8
TRANSCRIPTION_LANGUAGE=hi
# roman = Hinglish text, devanagari = Hindi script
TRANSCRIPTION_OUTPUT_SCRIPT=roman
TRANSCRIPTION_BEAM_SIZE=5
TRANSCRIPTION_VAD_FILTER=1
TRANSCRIPTION_VAD_THRESHOLD=0.50
TRANSCRIPTION_NO_SPEECH_THRESHOLD=0.55
TRANSCRIPTION_MAX_SEGMENT_NO_SPEECH_PROB=0.50
TRANSCRIPTION_MIN_AVG_LOGPROB=-0.80
TRANSCRIPTION_AUDIO_FILTER=highpass=f=100:poles=2,lowpass=f=3800:poles=2,afftdn=nr=12:nf=-40:tn=1,alimiter=limit=0.95
TRANSCRIPTION_AUDIO_SECONDS=0
# Leave empty: a prompt makes Whisper invent shop words on machine noise
TRANSCRIPTION_INITIAL_PROMPT=
TRANSCRIPTION_HOTWORDS=
# Extra shop-floor terms to correct, comma-separated (0 = turn correction off)
TRANSCRIPTION_VOCABULARY=
# Do not turn voice notes into downtime reasons automatically
TRANSCRIPTION_AUTO_REASON_ENABLED=0
TRANSCRIPTION_REASON_MAX_CHARS=240
TRANSCRIPTION_MIN_REASON_CHARS=8
TRANSCRIPTION_MIN_REASON_WORDS=2
# Optional local command provider. It must print transcript text to stdout.
# TRANSCRIPTION_COMMAND=your_transcriber_cli "{audio_path}"
